{# hard findings: legacy still active #}
{% if authority_mode_effective in ['legacy', 'ma_degraded_fallback'] %}
  {% set ns.hard = ns.hard + ['authority_mode_not_component_primary:' ~ authority_mode_effective] %}
{% endif %}

{% if authority_mode_wc in ['legacy', 'ma_degraded_fallback'] %}
  {% set ns.hard = ns.hard + ['write_controls_authority_not_component:' ~ authority_mode_wc] %}
{% endif %}

{% if metadata_owner_effective in ['legacy', 'legacy_contract_surfaces'] %}
  {% set ns.hard = ns.hard + ['metadata_owner_still_legacy:' ~ metadata_owner_effective] %}
{% endif %}

{% if not metadata_cutover_active %}
  {% set ns.hard = ns.hard + ['metadata_cutover_inactive'] %}
{% endif %}

{% if bridge_status in ['blocked_trial_stage', 'blocked_resolver_stage', 'blocked_target_recovery_stage'] %}
  {% set ns.hard = ns.hard + ['metadata_bridge_blocked:' ~ bridge_status] %}
{% endif %}

{% if trial_status in ['blocked_authority_not_satisfied', 'blocked_contract_invalid', 'blocked_missing_window_id'] %}
  {% set ns.hard = ns.hard + ['metadata_trial_blocked:' ~ trial_status] %}
{% endif %}

{% if (missing_required | count) > 0 or (unresolved_required | count) > 0 %}
  {% set ns.hard = ns.hard + ['contract_missing_or_unresolved_required_surfaces'] %}
{% endif %}

{% if (component_core_missing | count) > 0 %}
  {% set ns.hard = ns.hard + ['component_core_surfaces_missing:' ~ (component_core_missing | count)] %}
{% endif %}

{% if (component_backend_missing | count) > 0 %}
  {% set ns.notes = ns.notes + ['component_backend_surfaces_missing:' ~ (component_backend_missing | count)] %}
{% endif %}

{# hard findings: legacy runtime surface residue (must retire) #}
{% if r_control_host_present or r_control_port_present %}
  {% set ns.hard = ns.hard + ['legacy_runtime_control_surfaces_still_present'] %}
{% endif %}

{% if r_entity_present or r_title_present or r_source_present %}
  {% set ns.hard = ns.hard + ['legacy_runtime_now_playing_surfaces_still_present'] %}
{% endif %}

{% if r_backend_profile_present or r_api_url_present %}
  {% set ns.hard = ns.hard + ['legacy_runtime_backend_surfaces_still_present'] %}
{% endif %}

{% if not authority_contract_ready %}
  {% set ns.notes = ns.notes + ['authority_contract_not_ready'] %}
{% endif %}

{% if authority_contract_ready and (proof_presence.pre_window is not defined or proof_presence.in_window is not defined or proof_presence.post_window is not defined) %}
  {% set ns.notes = ns.notes + ['authority_contract_ready_but_checkpoint_shape_partial'] %}
{% endif %}

{% if bridge_status == 'skipped_component_startup_no_mix' %}
  {% set ns.notes = ns.notes + ['bridge skipped due to component-startup no-mix posture (not legacy by itself)'] %}
{% endif %}

{% if contract_valid == false %}
  {% set ns.notes = ns.notes + ['contract_validation_not_valid'] %}
{% endif %}

{# --- verdict --- #}
{% set verdict = 'PASS' %}
{% if (ns.hard | count) > 0 %}
  {% set verdict = 'FAIL' %}
{% endif %}

