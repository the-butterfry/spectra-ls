{# Description: Full-stack one-screen Spectra LS component validation template for HA Developer Tools. #}
{# Version: 2026.08.14.2 #}
{# Last updated: 2026-08-14 #}

{% set invalid = ['','none','unknown','unavailable','null'] %}

{% set shadow_entity = 'sensor.shadow_active_target' if states['sensor.shadow_active_target'] is not none else 'sensor.spectra_ls_shadow_active_target' %}
{% set shadow_exists = states[shadow_entity] is not none %}
{% set shadow_state = states(shadow_entity) if shadow_exists else 'missing' %}
{% set shadow_attrs = states[shadow_entity].attributes if shadow_exists and states[shadow_entity] is not none else {} %}
{% set captured_at = shadow_attrs.captured_at if shadow_attrs.captured_at is defined else none %}
{% set shadow_last_updated = states[shadow_entity].last_updated if shadow_exists and states[shadow_entity] is not none else none %}

{% set age_s = none %}
{% if captured_at is string and captured_at|trim not in invalid %}
  {% set cap_ts = as_timestamp(captured_at, none) %}
  {% if cap_ts is not none %}
    {% set age_s = as_timestamp(now()) - cap_ts %}
  {% endif %}
{% endif %}

{% if age_s is none and shadow_last_updated is not none %}
  {% set shadow_ts = as_timestamp(shadow_last_updated, none) %}
  {% if shadow_ts is not none %}
    {% set age_s = as_timestamp(now()) - shadow_ts %}
  {% endif %}
{% endif %}

{% set snapshot_fresh = (age_s is not none) and (age_s <= 300) %}

{% set route_trace = shadow_attrs.route_trace if shadow_attrs.route_trace is defined and shadow_attrs.route_trace is mapping else {} %}
{% set contract_validation = shadow_attrs.contract_validation if shadow_attrs.contract_validation is defined and shadow_attrs.contract_validation is mapping else {} %}
{% set scheduler_validation = shadow_attrs.scheduler_validation if shadow_attrs.scheduler_validation is defined and shadow_attrs.scheduler_validation is mapping else {} %}
{% set selection_handoff = shadow_attrs.selection_handoff_validation if shadow_attrs.selection_handoff_validation is defined and shadow_attrs.selection_handoff_validation is mapping else {} %}
{% set metadata_prep = shadow_attrs.metadata_prep_validation if shadow_attrs.metadata_prep_validation is defined and shadow_attrs.metadata_prep_validation is mapping else {} %}
{% set control_center = shadow_attrs.control_center_validation if shadow_attrs.control_center_validation is defined and shadow_attrs.control_center_validation is mapping else {} %}
{% set host_cutover = shadow_attrs.host_control_cutover_gate if shadow_attrs.host_control_cutover_gate is defined and shadow_attrs.host_control_cutover_gate is mapping else {} %}
{% set write_controls = shadow_attrs.write_controls if shadow_attrs.write_controls is defined and shadow_attrs.write_controls is mapping else {} %}
{% set authority_contract = shadow_attrs.authority_contract if shadow_attrs.authority_contract is defined and shadow_attrs.authority_contract is mapping else {} %}

{% set authority_mode = write_controls.authority_mode if write_controls.authority_mode is defined else 'unknown' %}
{% set last_attempt = write_controls.last_attempt if write_controls.last_attempt is defined and write_controls.last_attempt is mapping else {} %}
{% set last_attempt_status = last_attempt.status if last_attempt.status is defined else 'unknown' %}
{% set trial_attempt = write_controls.metadata_trial_last_attempt if write_controls.metadata_trial_last_attempt is defined and write_controls.metadata_trial_last_attempt is mapping else {} %}
{% set trial_status = trial_attempt.status if trial_attempt.status is defined else 'unknown' %}

{% set route_decision = route_trace.decision if route_trace.decision is defined else 'unknown' %}
{% set active_target = route_trace.active_target if route_trace.active_target is defined else 'unknown' %}
{% set active_path = route_trace.active_path if route_trace.active_path is defined else (route_trace.active_control_path if route_trace.active_control_path is defined else 'unknown') %}

{% set esp_handoff_entity = 'sensor.spectra_ls_system_esp_control_handoff_status' if states['sensor.spectra_ls_system_esp_control_handoff_status'] is not none else '' %}
{% set esp_oled_entity = 'sensor.spectra_ls_system_esp_oled_status' if states['sensor.spectra_ls_system_esp_oled_status'] is not none else '' %}
{% set esp_handoff_state = states(esp_handoff_entity) if esp_handoff_entity != '' else 'missing' %}
{% set esp_oled_state = states(esp_oled_entity) if esp_oled_entity != '' else 'missing' %}
{% set esp_runtime_visible = esp_handoff_entity != '' and esp_oled_entity != '' %}
{% set esp_mode_prefix = (esp_oled_state.split('|', 1)[0] if esp_oled_state is string and '|' in esp_oled_state else '') %}
{% set esp_oled_payload = (esp_oled_state.split('oled:', 1)[1] if esp_oled_state is string and 'oled:' in esp_oled_state else '') %}
{% set esp_lighting_blank_ok = esp_mode_prefix == 'lighting' and (esp_oled_payload | trim) in ['-', ''] %}
{% set esp_oled_ready = esp_oled_state not in invalid or esp_lighting_blank_ok %}
{% set esp_runtime_ready = esp_runtime_visible and esp_handoff_state not in invalid and esp_oled_ready %}
{% set esp_oled_last_updated = states[esp_oled_entity].last_updated if esp_oled_entity != '' and states[esp_oled_entity] is not none else none %}
{% set esp_oled_age_s = (as_timestamp(now()) - as_timestamp(esp_oled_last_updated)) if esp_oled_last_updated is not none else none %}

{% set helper_target = active_target %}
{% set helper_target_valid = active_target is string and active_target|trim not in invalid and '.' in active_target and states(active_target) not in invalid %}

{% set now_playing_entity = states('sensor.now_playing_entity') %}
{% set now_playing_state = states('sensor.now_playing_state') %}
{% set now_playing_title = states('sensor.now_playing_title') %}
{% set now_playing_preview_key = states('sensor.now_playing_preview_key') %}
{% set now_playing_freshness_age_s_raw = states('sensor.now_playing_freshness_age_s') %}
{% set now_playing_freshness_age_s = now_playing_freshness_age_s_raw | float(none) if now_playing_freshness_age_s_raw not in invalid else none %}
{% set now_playing_source = states('sensor.now_playing_source') %}
{% set now_playing_app = states('sensor.now_playing_app') %}
{% set now_playing_display_allowed = states('binary_sensor.now_playing_display_allowed') %}
{% set active_meta_entity = states('sensor.component_metadata_override_entity') %}

{% set component_now_playing_entity = states('sensor.component_now_playing_entity') %}
{% set component_now_playing_state = states('sensor.component_now_playing_state') %}
{% set component_now_playing_title = states('sensor.component_now_playing_title') %}
{% set component_now_playing_source = states('sensor.component_now_playing_source') %}
{% set component_now_playing_app = states('sensor.component_now_playing_app') %}
{% set component_now_playing_display_allowed = states('binary_sensor.component_now_playing_display_allowed') %}
{% set component_now_playing_freshness_age_raw = states('sensor.component_now_playing_freshness_age') %}
{% set component_now_playing_freshness_age = component_now_playing_freshness_age_raw | float(none) if component_now_playing_freshness_age_raw not in invalid else none %}

{% set effective_now_playing_entity = component_now_playing_entity if component_now_playing_entity not in invalid else now_playing_entity %}
{% set effective_now_playing_state = component_now_playing_state if component_now_playing_state not in invalid else now_playing_state %}
{% set effective_now_playing_title = component_now_playing_title if component_now_playing_title not in invalid else now_playing_title %}
{% set effective_now_playing_source = component_now_playing_source if component_now_playing_source not in invalid else now_playing_source %}
{% set effective_now_playing_app = component_now_playing_app if component_now_playing_app not in invalid else now_playing_app %}
{% set effective_now_playing_display_allowed = component_now_playing_display_allowed if component_now_playing_display_allowed not in invalid else now_playing_display_allowed %}
{% set effective_now_playing_freshness_age = component_now_playing_freshness_age if component_now_playing_freshness_age is not none else now_playing_freshness_age_s %}

{% set metadata_checks = metadata_prep.checks if metadata_prep.checks is defined and metadata_prep.checks is mapping else {} %}
{% set metadata_values = metadata_prep.values if metadata_prep.values is defined and metadata_prep.values is mapping else {} %}
{% set selector_raw = metadata_values.component_now_playing_selection if metadata_values.component_now_playing_selection is defined else {} %}
{% set selector = selector_raw if selector_raw is mapping else ((selector_raw | from_json) if (selector_raw is string and (selector_raw | trim).startswith('{')) else {}) %}
{% set selector_winner_entity = metadata_checks.component_now_playing_selection_winner_entity if metadata_checks.component_now_playing_selection_winner_entity is defined else (metadata_values.component_now_playing_selection_winner_entity if metadata_values.component_now_playing_selection_winner_entity is defined else (selector.winner_entity if selector.winner_entity is defined else 'unknown')) %}
{% set selector_winner_source = metadata_checks.component_now_playing_selection_winner_source if metadata_checks.component_now_playing_selection_winner_source is defined else (metadata_values.component_now_playing_selection_winner_source if metadata_values.component_now_playing_selection_winner_source is defined else (selector.winner_source if selector.winner_source is defined else 'unknown')) %}
{% set selector_winner_pool = metadata_checks.component_now_playing_selection_winner_pool if metadata_checks.component_now_playing_selection_winner_pool is defined else (selector.winner_pool if selector.winner_pool is defined else 'unknown') %}
{% set selector_winner_reason = metadata_checks.component_now_playing_selection_winner_reason if metadata_checks.component_now_playing_selection_winner_reason is defined else (selector.winner_reason if selector.winner_reason is defined else 'unknown') %}
{% set selector_candidate_count = metadata_checks.component_now_playing_selection_candidate_count if metadata_checks.component_now_playing_selection_candidate_count is defined else (selector.candidate_count if selector.candidate_count is defined else 'unknown') %}
{% set selector_eligible_count = metadata_checks.component_now_playing_selection_eligible_count if metadata_checks.component_now_playing_selection_eligible_count is defined else (selector.eligible_count if selector.eligible_count is defined else 'unknown') %}
{% set track_metadata_ready = metadata_checks.now_playing_track_metadata_ready if metadata_checks.now_playing_track_metadata_ready is defined else (metadata_values.now_playing_track_metadata_ready if metadata_values.now_playing_track_metadata_ready is defined else 'unknown') %}
{% set no_track_source_continuity_preferred = metadata_checks.passthrough_no_track_source_continuity_preferred if metadata_checks.passthrough_no_track_source_continuity_preferred is defined else (metadata_values.passthrough_no_track_source_continuity_preferred if metadata_values.passthrough_no_track_source_continuity_preferred is defined else false) %}

{% set control_meta_entity_mismatch = active_target not in invalid and effective_now_playing_entity not in invalid and active_target != effective_now_playing_entity %}
{% set source_hint = effective_now_playing_source | lower if effective_now_playing_source not in invalid else '' %}
{% set app_hint = effective_now_playing_app | lower if effective_now_playing_app not in invalid else '' %}
{% set appletv_youtube_context = ('apple' in source_hint) or ('youtube' in source_hint) or ('apple' in app_hint) or ('youtube' in app_hint) %}
{% set passthrough_source_detected = ('optical' in source_hint) or ('line in' in source_hint) or ('line-in' in source_hint) or ('aux' in source_hint) or ('hdmi' in source_hint) or ('arc' in source_hint) %}
{% set stale_now_playing = effective_now_playing_freshness_age is not none and effective_now_playing_freshness_age > 45 %}
{% set display_not_allowed = effective_now_playing_display_allowed in ['off', 'false', '0'] %}
{% set oled_audio_blank = esp_mode_prefix == 'audio' and (esp_oled_payload | trim) in ['', '-'] %}
{% set selector_partial_telemetry = selector_winner_entity in invalid and selector_winner_pool not in ['unknown', 'none', ''] %}
{% set oled_payload_trim = esp_oled_payload | trim %}
{% set oled_payload_lower = oled_payload_trim | lower if oled_payload_trim not in invalid else '' %}
{% set effective_title_trim = effective_now_playing_title | trim if effective_now_playing_title not in invalid else '' %}
{% set effective_source_trim = effective_now_playing_source | trim if effective_now_playing_source not in invalid else '' %}
{% set effective_app_trim = effective_now_playing_app | trim if effective_now_playing_app not in invalid else '' %}
{% set effective_title_lower = effective_title_trim | lower if effective_title_trim != '' else '' %}
{% set effective_source_lower = effective_source_trim | lower if effective_source_trim != '' else '' %}
{% set effective_app_lower = effective_app_trim | lower if effective_app_trim != '' else '' %}
{% set oled_matches_title_prefix = effective_title_lower != '' and oled_payload_lower != '' and (effective_title_lower.startswith(oled_payload_lower) or oled_payload_lower.startswith(effective_title_lower)) %}
{% set oled_matches_source = effective_source_lower != '' and oled_payload_lower == effective_source_lower %}
{% set oled_matches_app = effective_app_lower != '' and oled_payload_lower == effective_app_lower %}
{% set oled_payload_contract_match = oled_matches_title_prefix or oled_matches_source or oled_matches_app %}
{% set oled_payload_contract_mismatch = esp_mode_prefix == 'audio' and oled_payload_trim not in invalid and track_metadata_ready == true and effective_title_trim != '' and not oled_payload_contract_match %}
{% set oled_status_stale_vs_title = esp_oled_age_s is not none and esp_oled_age_s > 90 and effective_now_playing_freshness_age is not none and effective_now_playing_freshness_age <= 20 %}

{% set oled_cause = 'healthy_or_non_blank_case' %}
{% if esp_oled_state in invalid %}
  {% set oled_cause = 'esp_oled_status_missing' %}
{% elif esp_mode_prefix not in ['audio', 'lighting'] %}
  {% set oled_cause = 'oled_not_in_audio_or_lighting_mode' %}
{% elif esp_lighting_blank_ok %}
  {% set oled_cause = 'lighting_blank_expected' %}
{% elif oled_audio_blank and display_not_allowed %}
  {% set oled_cause = 'display_policy_suppressed' %}
{% elif oled_audio_blank and stale_now_playing %}
  {% set oled_cause = 'now_playing_freshness_stale' %}
{% elif oled_audio_blank and passthrough_source_detected and effective_now_playing_title in invalid %}
  {% set oled_cause = 'passthrough_no_track_metadata' %}
{% elif oled_audio_blank and selector_partial_telemetry %}
  {% set oled_cause = 'selector_telemetry_partial' %}
{% elif oled_payload_contract_mismatch %}
  {% set oled_cause = 'oled_payload_contract_mismatch' %}
{% elif oled_status_stale_vs_title %}
  {% set oled_cause = 'oled_status_stale_vs_component_title' %}
{% elif oled_audio_blank and control_meta_entity_mismatch and effective_now_playing_state in ['playing', 'paused'] %}
  {% set oled_cause = 'control_metadata_entity_divergence' %}
{% elif oled_audio_blank and effective_now_playing_title in invalid and effective_now_playing_source not in invalid %}
  {% set oled_cause = 'title_missing_source_present' %}
{% elif oled_audio_blank %}
  {% set oled_cause = 'audio_blank_unclassified' %}
{% endif %}

{% set host_sensor = states('sensor.component_control_host') %}
{% set hosts_sensor = states('sensor.component_control_hosts') %}
{% set component_backend_profile = states('sensor.component_backend_profile') %}
{% set component_api_url = states('sensor.component_ma_api_url') %}
{% set helper_backend_profile = 'missing' %}
{% set helper_api_url = 'missing' %}
{% set effective_backend_profile = component_backend_profile if component_backend_profile not in invalid else helper_backend_profile %}
{% set effective_api_url = component_api_url if component_api_url not in invalid else helper_api_url %}
{% set backend_source = 'component_primary' if component_backend_profile not in invalid else 'component_missing' %}
{% set api_source = 'component_primary' if component_api_url not in invalid else 'component_missing' %}
{% set backend_profile_ready = (effective_backend_profile | lower) in ['beta','stable','manual','component_discovered'] %}
{% set backend_api_ready = effective_api_url not in invalid and (effective_api_url | lower).startswith('http') %}
{% set backend_api_contract_ready = backend_profile_ready and backend_api_ready %}

{% set contract_ready_raw = contract_validation.ready if contract_validation.ready is defined else none %}
{% set contract_valid = contract_validation.valid if contract_validation.valid is defined else false %}
{% set missing_required = contract_validation.missing_required if contract_validation.missing_required is defined and contract_validation.missing_required is sequence else [] %}
{% set unresolved_required = contract_validation.unresolved_required if contract_validation.unresolved_required is defined and contract_validation.unresolved_required is sequence else [] %}
{% set unresolved_sources = shadow_attrs.unresolved_sources if shadow_attrs.unresolved_sources is defined and shadow_attrs.unresolved_sources is sequence else (contract_validation.unresolved_sources if contract_validation.unresolved_sources is defined and contract_validation.unresolved_sources is sequence else []) %}
{% set mismatches = shadow_attrs.mismatches if shadow_attrs.mismatches is defined and shadow_attrs.mismatches is sequence else (contract_validation.mismatches if contract_validation.mismatches is defined and contract_validation.mismatches is sequence else []) %}
{% set missing_required_count = missing_required | count %}
{% set unresolved_required_count = unresolved_required | count %}
{% set unresolved_sources_count = unresolved_sources | count %}
{% set mismatches_count = mismatches | count %}
{% set contract_ready = contract_ready_raw if contract_ready_raw is not none else (contract_valid and missing_required_count == 0 and unresolved_required_count == 0) %}

{% set scheduler_verdict = scheduler_validation.verdict if scheduler_validation.verdict is defined else 'unknown' %}
{% set handoff_verdict = selection_handoff.verdict if selection_handoff.verdict is defined else 'unknown' %}
{% set metadata_verdict = metadata_prep.verdict if metadata_prep.verdict is defined else 'unknown' %}

{% set host_cutover_ready = host_cutover.ready_for_cutover if host_cutover.ready_for_cutover is defined else false %}
{% set host_activation_ready = host_cutover.ready_for_authoritative_activation if host_cutover.ready_for_authoritative_activation is defined else false %}
{% set authority_contract_ready = authority_contract.authority_contract_ready if authority_contract.authority_contract_ready is defined else false %}
{% set metadata_blockers = metadata_prep.blocking_reasons if metadata_prep.blocking_reasons is defined and metadata_prep.blocking_reasons is sequence else [] %}
{% set authority_reasons = authority_contract.authority_reasons if authority_contract.authority_reasons is defined and authority_contract.authority_reasons is sequence else [] %}

{% set ns = namespace(score=0, max=13, blockers=[]) %}

{% if shadow_exists %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['shadow_entity_missing'] %}{% endif %}
{% if snapshot_fresh %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['snapshot_not_fresh'] %}{% endif %}
{% if helper_target_valid %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['helper_target_invalid'] %}{% endif %}
{% if route_decision == 'route_linkplay_tcp' %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['route_not_linkplay_tcp'] %}{% endif %}
{% if contract_ready and contract_valid and missing_required_count == 0 and unresolved_required_count == 0 %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['contract_not_clean'] %}{% endif %}
{% if unresolved_sources_count == 0 and mismatches_count == 0 %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['parity_drift_detected'] %}{% endif %}
{% if scheduler_verdict == 'PASS' %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['scheduler_not_pass'] %}{% endif %}
{% if handoff_verdict == 'PASS' %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['handoff_not_pass'] %}{% endif %}
{% if metadata_verdict == 'PASS' and (metadata_prep.ready_for_metadata_handoff if metadata_prep.ready_for_metadata_handoff is defined else false) %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['metadata_prep_not_ready'] %}{% endif %}
{% if backend_api_contract_ready %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['backend_api_not_ready'] %}{% endif %}
{% if esp_runtime_ready %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['esp_runtime_not_ready'] %}{% endif %}
{% if host_cutover_ready and host_activation_ready %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['host_cutover_not_ready'] %}{% endif %}
{% if authority_contract_ready %}{% set ns.score = ns.score + 1 %}{% else %}{% set ns.blockers = ns.blockers + ['authority_contract_not_ready'] %}{% endif %}

{% set verdict = 'PASS' %}
{% if ns.score < 11 %}
  {% set verdict = 'FAIL' %}
{% elif ns.score < ns.max %}
  {% set verdict = 'WARN' %}
{% endif %}

### Spectra LS Meta Component Full-Stack Tester
- Result: **{{ verdict }}**
- Timestamp: **{{ now() }}**
- Score: **{{ ns.score }}/{{ ns.max }}**
- Snapshot source: **{{ shadow_entity }}**

### Core context
- `authority_mode`: **{{ authority_mode }}**
- Active target (route/helper): **{{ active_target }} / {{ helper_target }}**
- Active path/decision: **{{ active_path }} / {{ route_decision }}**
- Control host(s): **{{ host_sensor }} / {{ hosts_sensor }}**
- Backend/API (effective): **{{ effective_backend_profile }} / {{ effective_api_url }}**
- Backend/API source: **{{ backend_source }} / {{ api_source }}**
- Meta entity: **{{ active_meta_entity }}**
- Component now playing: **{{ component_now_playing_entity }} | {{ component_now_playing_state }} | {{ component_now_playing_title }}**
- Runtime now playing: **{{ now_playing_entity }} | {{ now_playing_state }} | {{ now_playing_title }}**
- Effective now playing: **{{ effective_now_playing_entity }} | {{ effective_now_playing_state }} | {{ effective_now_playing_title }}**
- Preview key: **{{ now_playing_preview_key if now_playing_preview_key not in invalid else 'missing' }}**
- Freshness age (component/runtime/effective s): **{{ (component_now_playing_freshness_age | round(1)) if component_now_playing_freshness_age is not none else 'missing' }} / {{ (now_playing_freshness_age_s | round(1)) if now_playing_freshness_age_s is not none else 'missing' }} / {{ (effective_now_playing_freshness_age | round(1)) if effective_now_playing_freshness_age is not none else 'missing' }}**
- ESP handoff/oled: **{{ esp_handoff_state }} / {{ esp_oled_state }}**
- ESP oled mode-semantic: **{{ 'lighting_blank_expected' if esp_lighting_blank_ok else 'normal' }}**

### OLED blank diagnosis
- Classified cause: **{{ oled_cause }}**
- OLED audio blank: **{{ oled_audio_blank }}**
- Display allowed (effective): **{{ effective_now_playing_display_allowed if effective_now_playing_display_allowed not in invalid else 'missing' }}**
- Source/app (effective): **{{ effective_now_playing_source if effective_now_playing_source not in invalid else 'missing' }} / {{ effective_now_playing_app if effective_now_playing_app not in invalid else 'missing' }}**
- Passthrough source detected: **{{ passthrough_source_detected }}**
- AppleTV/YouTube context detected: **{{ appletv_youtube_context }}**
- Title missing while source present: **{{ effective_now_playing_title in invalid and effective_now_playing_source not in invalid }}**
- Control target vs effective now-playing mismatch: **{{ control_meta_entity_mismatch }}**
- Selector winner (entity/source): **{{ selector_winner_entity if selector_winner_entity not in invalid else 'missing' }} / {{ selector_winner_source if selector_winner_source not in invalid else 'missing' }}**
- Selector winner (pool/reason): **{{ selector_winner_pool if selector_winner_pool not in invalid else 'missing' }} / {{ selector_winner_reason if selector_winner_reason not in invalid else 'missing' }}**
- Selector candidate/eligible counts: **{{ selector_candidate_count if selector_candidate_count not in invalid else 'missing' }} / {{ selector_eligible_count if selector_eligible_count not in invalid else 'missing' }}**
- Selector partial telemetry: **{{ selector_partial_telemetry }}**
- Track metadata ready (component): **{{ track_metadata_ready }}**
- Passthrough no-track source continuity preferred: **{{ no_track_source_continuity_preferred }}**
- OLED payload contract match (title/source/app): **{{ oled_payload_contract_match }}**
- OLED payload contract mismatch: **{{ oled_payload_contract_mismatch }}**
- OLED status stale vs fresh component title: **{{ oled_status_stale_vs_title }}**{% if esp_oled_age_s is not none %} (oled_age={{ esp_oled_age_s | round(1) }}s){% endif %}

### Contract + parity
- contract ready/valid: **{{ contract_ready }} / {{ contract_valid }}**
- missing/unresolved required: **{{ missing_required_count }} / {{ unresolved_required_count }}**
- unresolved sources / mismatches: **{{ unresolved_sources_count }} / {{ mismatches_count }}**
- snapshot fresh: **{{ snapshot_fresh }}**{% if age_s is not none %} (age={{ age_s | round(1) }}s){% endif %}

### Functional gates
- scheduler: **{{ scheduler_verdict }}**
- selection handoff: **{{ handoff_verdict }}**
- metadata prep: **{{ metadata_verdict }}** (ready={{ metadata_prep.ready_for_metadata_handoff if metadata_prep.ready_for_metadata_handoff is defined else false }})
- metadata blockers: **{{ (metadata_blockers | join(', ')) if (metadata_blockers | length) > 0 else 'none' }}**
- backend/api read lane: **{{ 'ready' if backend_api_contract_ready else 'degraded_or_missing' }}**
- esp runtime telemetry: **{{ 'ready' if esp_runtime_ready else 'degraded_or_missing' }}**{% if esp_lighting_blank_ok %} (lighting blank expected){% endif %}
- host cutover gate: **ready={{ host_cutover_ready }} / activation={{ host_activation_ready }}**
- authority contract ready: **{{ authority_contract_ready }}**
- authority reasons: **{{ (authority_reasons | join(', ')) if (authority_reasons | length) > 0 else 'none' }}**

### Write-attempt telemetry
- last write attempt: **{{ last_attempt_status }}**
