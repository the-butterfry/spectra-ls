{# Description: Fast smoke-check template for OLED/control/meta alignment in repeated live validation loops. #}
{# Version: 2026.08.18.1 #}
{# Last updated: 2026-08-18 #}

{# Purpose:
  - Quick PASS/WARN/FAIL posture for fast reruns while tuning fixes.
  - Lower-overhead companion to oled_now_playing_validation.jinja.
#}

{% set invalid = ['', 'none', 'unknown', 'unavailable', 'null', none] %}

{% set s_target_primary = 'sensor.shadow_active_target' %}
{% set s_target_fallback = 'sensor.spectra_ls_shadow_active_target' %}
{% set s_target = s_target_primary if (state_attr(s_target_primary, 'route_trace') is not none) else s_target_fallback %}

{% set route_trace = state_attr(s_target, 'route_trace') or {} %}
{% set metadata_prep = state_attr(s_target, 'metadata_prep_validation') or {} %}
{% if route_trace is not mapping %}{% set route_trace = {} %}{% endif %}
{% if metadata_prep is not mapping %}{% set metadata_prep = {} %}{% endif %}

{% set metadata_values = metadata_prep.values if metadata_prep.values is defined and metadata_prep.values is mapping else {} %}
{% set metadata_checks = metadata_prep.checks if metadata_prep.checks is defined and metadata_prep.checks is mapping else {} %}

{% set effective_entity = states('sensor.component_now_playing_entity') %}
{% if effective_entity in invalid %}{% set effective_entity = states('sensor.now_playing_entity') %}{% endif %}

{% set effective_title = states('sensor.component_now_playing_title') %}
{% if effective_title in invalid %}{% set effective_title = states('sensor.now_playing_title') %}{% endif %}

{% set effective_source = states('sensor.component_now_playing_source') %}
{% if effective_source in invalid %}{% set effective_source = states('sensor.now_playing_source') %}{% endif %}

{% set effective_state = states('sensor.component_now_playing_state') %}
{% if effective_state in invalid %}{% set effective_state = states('sensor.now_playing_state') %}{% endif %}

{% set effective_display_allowed = states('binary_sensor.component_now_playing_display_allowed') %}
{% if effective_display_allowed in invalid %}{% set effective_display_allowed = states('binary_sensor.now_playing_display_allowed') %}{% endif %}

{% set effective_control_target = states('sensor.component_active_target') %}
{% if effective_control_target in invalid %}{% set effective_control_target = route_trace.active_target if route_trace.active_target is defined else states('input_select.ma_active_target') %}{% endif %}

{% set effective_meta_target = metadata_values.active_meta_entity | default(states('sensor.ma_active_meta_entity')) %}

{% set esp_target = states('sensor.spectra_ls_system_esp_control_target') %}
{% set esp_oled = states('sensor.spectra_ls_system_esp_oled_status') %}
{% set esp_mode = esp_oled.split('|', 1)[0] if esp_oled not in invalid and '|' in esp_oled else 'unknown' %}
{% set esp_payload = esp_oled.split('oled:', 1)[1] if esp_oled not in invalid and 'oled:' in esp_oled else '' %}
{% set esp_payload_trim = esp_payload | trim %}

{% set title_missing = effective_title in invalid %}
{% set source_missing = effective_source in invalid %}
{% set display_blocked = effective_display_allowed in ['off', 'false', '0'] %}
{% set control_target_mismatch = effective_control_target not in invalid and effective_entity not in invalid and effective_control_target != effective_entity %}
{% set meta_target_mismatch = effective_meta_target not in invalid and effective_entity not in invalid and effective_meta_target != effective_entity %}
{% set esp_target_mismatch = esp_target not in invalid and effective_control_target not in invalid and esp_target != effective_control_target %}
{% set src_fallback = (esp_payload_trim | upper) == 'SRC' or ('|SRC' in (esp_oled | upper)) %}

{% set cause = 'healthy_or_non_src_case' %}
{% if esp_target_mismatch %}
  {% set cause = 'control_target_mismatch_esp_vs_effective_control_target' %}
{% elif control_target_mismatch %}
  {% set cause = 'control_target_vs_now_playing_entity_mismatch' %}
{% elif meta_target_mismatch %}
  {% set cause = 'meta_target_vs_now_playing_entity_mismatch' %}
{% elif display_blocked and src_fallback %}
  {% set cause = 'display_policy_suppressed' %}
{% elif src_fallback and title_missing and not source_missing %}
  {% set cause = 'title_missing_source_present_fallback_to_src' %}
{% elif src_fallback and title_missing and source_missing %}
  {% set cause = 'no_viable_now_playing_contract_fields' %}
{% elif esp_mode not in ['audio'] %}
  {% set cause = 'oled_not_in_audio_mode' %}
{% endif %}

{% set verdict = 'PASS' %}
{% if cause in [
  'control_target_mismatch_esp_vs_effective_control_target',
  'control_target_vs_now_playing_entity_mismatch',
  'meta_target_vs_now_playing_entity_mismatch',
  'title_missing_source_present_fallback_to_src',
  'no_viable_now_playing_contract_fields'
] %}
  {% set verdict = 'FAIL' %}
{% elif cause in ['display_policy_suppressed', 'oled_not_in_audio_mode'] %}
  {% set verdict = 'WARN' %}
{% endif %}

### OLED Smoke Check
- Result: **{{ verdict }}**
- Cause: **{{ cause }}**
- Timestamp: **{{ now() }}**

### Core posture
- effective entity/state: **{{ effective_entity if effective_entity not in invalid else 'n/a' }} / {{ effective_state if effective_state not in invalid else 'n/a' }}**
- effective title/source: **{{ effective_title if effective_title not in invalid else 'n/a' }} / {{ effective_source if effective_source not in invalid else 'n/a' }}**
- control target/meta target: **{{ effective_control_target if effective_control_target not in invalid else 'n/a' }} / {{ effective_meta_target if effective_meta_target not in invalid else 'n/a' }}**
- esp target + oled mode/payload: **{{ esp_target if esp_target not in invalid else 'n/a' }} / {{ esp_mode }} / {{ esp_payload_trim if esp_payload_trim != '' else 'n/a' }}**
- src fallback: **{{ src_fallback }}**

### Quick mismatches
- control-target vs now-playing mismatch: **{{ control_target_mismatch }}**
- meta-target vs now-playing mismatch: **{{ meta_target_mismatch }}**
- effective control target vs esp target mismatch: **{{ esp_target_mismatch }}**
- display blocked: **{{ display_blocked }}**

### Next action
{% if verdict == 'FAIL' %}
- Run `docs/testing/raw/oled_now_playing_validation.jinja` immediately and capture full packet.
{% elif verdict == 'WARN' %}
- Re-run during active playback window; if warning persists, capture full template packet.
{% else %}
- Smoke check is clean; continue functional validation or compare against known-good captures.
{% endif %}
