{# Description: Raw copy/paste Developer Tools template to validate OLED, control target, and meta target alignment (including SRC fallback causes). #}
{# Version: 2026.07.25.4 #}
{# Last updated: 2026-07-25 #}

{# =========================
  OLED + Control Target + Meta Target Validation
  Purpose:
    - Validate current OLED now-playing payload vs component/runtime contracts.
    - Validate control-target chain alignment (component/route/ESP, helper as advisory).
    - Validate meta-target chain alignment (metadata-prep owner/active-meta/now-playing entity).
    - Detect when OLED is in SRC fallback posture.
    - Inspect component selector winner policy (pool/reason/disqualifiers).
    - Classify likely root cause without guessing.
    - Treat issue posture as live-state dependent (not restart-dependent).
  Usage:
    1) Paste into Home Assistant -> Developer Tools -> Template.
    2) Run while the OLED is showing the issue.
    3) Capture output packet for diff against a known-good run.
  ========================= #}

{% set invalid = ['', 'none', 'unknown', 'unavailable', 'null', none] %}

{# --- shadow packet for route + metadata authority context --- #}
{% set s_target_primary = 'sensor.shadow_active_target' %}
{% set s_target_fallback = 'sensor.spectra_ls_shadow_active_target' %}
{% set primary_has_attrs = state_attr(s_target_primary, 'route_trace') is not none or state_attr(s_target_primary, 'captured_at') is not none %}
{% set fallback_has_attrs = state_attr(s_target_fallback, 'route_trace') is not none or state_attr(s_target_fallback, 'captured_at') is not none %}
{% set s_target = s_target_primary if primary_has_attrs else (s_target_fallback if fallback_has_attrs else s_target_primary) %}

{% set route_trace = state_attr(s_target, 'route_trace') or {} %}
{% set metadata_prep = state_attr(s_target, 'metadata_prep_validation') or {} %}
{% if route_trace is not mapping %}{% set route_trace = {} %}{% endif %}
{% if metadata_prep is not mapping %}{% set metadata_prep = {} %}{% endif %}

{% set route_decision = route_trace.decision if route_trace.decision is defined else 'unknown' %}
{% set route_active_target = route_trace.active_target if route_trace.active_target is defined else 'unknown' %}
{% set metadata_owner = metadata_prep.metadata_authority_owner if metadata_prep.metadata_authority_owner is defined else 'unknown' %}
{% set metadata_checks = metadata_prep.checks if metadata_prep.checks is defined and metadata_prep.checks is mapping else {} %}
{% set metadata_values = metadata_prep.values if metadata_prep.values is defined and metadata_prep.values is mapping else {} %}
{% set metadata_canonical = metadata_prep.canonical_summary if metadata_prep.canonical_summary is defined and metadata_prep.canonical_summary is mapping else {} %}
{% set packet_meta_target = metadata_values.active_meta_entity if metadata_values.active_meta_entity is defined else 'unknown' %}
{% set packet_canonical_control_target = metadata_values.canonical_control_target if metadata_values.canonical_control_target is defined else (metadata_canonical.control_target if metadata_canonical.control_target is defined else 'unknown') %}
{% set packet_canonical_meta_target = metadata_values.canonical_meta_target if metadata_values.canonical_meta_target is defined else (metadata_canonical.meta_target if metadata_canonical.meta_target is defined else 'unknown') %}
{% set packet_canonical_now_playing_entity = metadata_values.canonical_now_playing_entity if metadata_values.canonical_now_playing_entity is defined else (metadata_canonical.now_playing_entity if metadata_canonical.now_playing_entity is defined else 'unknown') %}
{% set packet_canonical_alignment_state = metadata_values.canonical_alignment_state if metadata_values.canonical_alignment_state is defined else (metadata_canonical.alignment_state if metadata_canonical.alignment_state is defined else 'unknown') %}
{% set packet_canonical_oled_posture = metadata_values.canonical_oled_posture if metadata_values.canonical_oled_posture is defined else (metadata_canonical.oled_posture if metadata_canonical.oled_posture is defined else 'unknown') %}
{% set packet_canonical_oled_payload_ready = metadata_values.canonical_oled_payload_ready if metadata_values.canonical_oled_payload_ready is defined else (metadata_canonical.oled_payload_ready if metadata_canonical.oled_payload_ready is defined else 'unknown') %}
{% set packet_canonical_cause = metadata_values.canonical_cause_hint if metadata_values.canonical_cause_hint is defined else (metadata_canonical.cause_hint if metadata_canonical.cause_hint is defined else 'unknown') %}
{% set packet_now_playing_app = metadata_values.now_playing_app if metadata_values.now_playing_app is defined else 'unknown' %}
{% set packet_now_playing_source = metadata_values.now_playing_source if metadata_values.now_playing_source is defined else 'unknown' %}
{% set packet_resolver_selected_meta_entity = metadata_values.resolver_selected_meta_entity if metadata_values.resolver_selected_meta_entity is defined else 'unknown' %}
{% set packet_component_entity_source = metadata_values.component_now_playing_entity_source if metadata_values.component_now_playing_entity_source is defined else 'unknown' %}
{% set packet_passthrough_album_suppressed = metadata_values.passthrough_album_suppressed if metadata_values.passthrough_album_suppressed is defined else 'unknown' %}
{% set packet_passthrough_cache_reused = metadata_values.passthrough_metadata_cache_reused if metadata_values.passthrough_metadata_cache_reused is defined else 'unknown' %}
{% set packet_passthrough_cache_age_s = metadata_values.passthrough_metadata_cache_age_s if metadata_values.passthrough_metadata_cache_age_s is defined else 'unknown' %}
{% set packet_passthrough_upstream_meta_fallback_used = metadata_values.passthrough_upstream_meta_fallback_used if metadata_values.passthrough_upstream_meta_fallback_used is defined else 'unknown' %}
{% set packet_passthrough_upstream_meta_entity = metadata_values.passthrough_upstream_meta_entity if metadata_values.passthrough_upstream_meta_entity is defined else 'unknown' %}
{% set packet_passthrough_upstream_meta_reason = metadata_values.passthrough_upstream_meta_reason if metadata_values.passthrough_upstream_meta_reason is defined else 'unknown' %}
{% set packet_passthrough_upstream_meta_score = metadata_values.passthrough_upstream_meta_score if metadata_values.passthrough_upstream_meta_score is defined else 'unknown' %}
{% set packet_selector_raw = metadata_values.component_now_playing_selection if metadata_values.component_now_playing_selection is defined else {} %}
{% set packet_selector = packet_selector_raw if packet_selector_raw is mapping else ((packet_selector_raw | from_json) if (packet_selector_raw is string and (packet_selector_raw | trim).startswith('{')) else {}) %}
{% set packet_selector_winner_entity_raw = metadata_checks.component_now_playing_selection_winner_entity if metadata_checks.component_now_playing_selection_winner_entity is defined else (metadata_values.component_now_playing_selection_winner_entity if metadata_values.component_now_playing_selection_winner_entity is defined else (packet_selector.winner_entity if packet_selector.winner_entity is defined else 'unknown')) %}
{% set packet_selector_winner_source_raw = metadata_checks.component_now_playing_selection_winner_source if metadata_checks.component_now_playing_selection_winner_source is defined else (metadata_values.component_now_playing_selection_winner_source if metadata_values.component_now_playing_selection_winner_source is defined else (packet_selector.winner_source if packet_selector.winner_source is defined else 'unknown')) %}
{% set packet_selector_winner_pool = metadata_checks.component_now_playing_selection_winner_pool if metadata_checks.component_now_playing_selection_winner_pool is defined else (packet_selector.winner_pool if packet_selector.winner_pool is defined else 'unknown') %}
{% set packet_selector_winner_reason = metadata_checks.component_now_playing_selection_winner_reason if metadata_checks.component_now_playing_selection_winner_reason is defined else (packet_selector.winner_reason if packet_selector.winner_reason is defined else 'unknown') %}
{% set packet_selector_ma_rich_active_exists = metadata_checks.component_now_playing_selection_ma_rich_active_exists if metadata_checks.component_now_playing_selection_ma_rich_active_exists is defined else (packet_selector.ma_rich_active_exists if packet_selector.ma_rich_active_exists is defined else 'unknown') %}
{% set packet_selector_candidate_count = metadata_checks.component_now_playing_selection_candidate_count if metadata_checks.component_now_playing_selection_candidate_count is defined else (packet_selector.candidate_count if packet_selector.candidate_count is defined else 'unknown') %}
{% set packet_selector_eligible_count = metadata_checks.component_now_playing_selection_eligible_count if metadata_checks.component_now_playing_selection_eligible_count is defined else (packet_selector.eligible_count if packet_selector.eligible_count is defined else 'unknown') %}
{% set packet_selector_candidates = packet_selector.candidates if packet_selector.candidates is defined and packet_selector.candidates is iterable else [] %}

{% set sparse_blocked = namespace(count=0, entities=[]) %}
{% for row in packet_selector_candidates if row is mapping %}
  {% set row_reasons = row.reasons if row.reasons is defined and row.reasons is iterable else [] %}
  {% if 'sparse_transport_blocked_by_ma_rich' in row_reasons %}
    {% set sparse_blocked.count = sparse_blocked.count + 1 %}
    {% set sparse_blocked.entities = sparse_blocked.entities + [row.entity if row.entity is defined else 'unknown'] %}
  {% endif %}
{% endfor %}

{# --- component-first now-playing contracts --- #}
{% set c_entity = states('sensor.component_now_playing_entity') %}
{% set c_state = states('sensor.component_now_playing_state') %}
{% set c_title = states('sensor.component_now_playing_title') %}
{% set c_artist = states('sensor.component_now_playing_artist') %}
{% set c_album = states('sensor.component_now_playing_album') %}
{% set c_source = states('sensor.component_now_playing_source') %}
{% set c_app = states('sensor.component_now_playing_app') %}
{% set c_display_allowed = states('binary_sensor.component_now_playing_display_allowed') %}
{% set c_freshness_raw = states('sensor.component_now_playing_freshness_age') %}
{% set c_freshness = c_freshness_raw | float(none) if c_freshness_raw not in invalid else none %}

{# --- runtime legacy/fallback surfaces --- #}
{% set r_entity = states('sensor.now_playing_entity') %}
{% set r_state = states('sensor.now_playing_state') %}
{% set r_title = states('sensor.now_playing_title') %}
{% set r_artist = states('sensor.now_playing_artist') %}
{% set r_album = states('sensor.now_playing_album') %}
{% set r_source = states('sensor.now_playing_source') %}
{% set r_app = states('sensor.now_playing_app') %}
{% set r_display_allowed = states('binary_sensor.now_playing_display_allowed') %}
{% set r_freshness_raw = states('sensor.now_playing_freshness_age_s') %}
{% set r_freshness = r_freshness_raw | float(none) if r_freshness_raw not in invalid else none %}

{# --- effective contract view (component-first) --- #}
{% set effective_entity = c_entity if c_entity not in invalid else r_entity %}
{% set effective_state = c_state if c_state not in invalid else r_state %}
{% set effective_title = c_title if c_title not in invalid else r_title %}
{% set effective_artist = c_artist if c_artist not in invalid else r_artist %}
{% set effective_album = c_album if c_album not in invalid else r_album %}
{% set effective_source = c_source if c_source not in invalid else r_source %}
{% set effective_app = c_app if c_app not in invalid else r_app %}
{% set effective_display_allowed = c_display_allowed if c_display_allowed not in invalid else r_display_allowed %}
{% set effective_freshness = c_freshness if c_freshness is not none else r_freshness %}
{% set packet_selector_winner_entity = packet_selector_winner_entity_raw if packet_selector_winner_entity_raw not in invalid else (effective_entity if packet_selector_winner_pool not in ['unknown', 'none', ''] and metadata_owner in ['component', 'component_primary', 'component_contract_surfaces'] else packet_selector_winner_entity_raw) %}
{% set packet_selector_winner_source = packet_selector_winner_source_raw if packet_selector_winner_source_raw not in invalid else (packet_component_entity_source if packet_component_entity_source not in invalid else packet_selector_winner_source_raw) %}
{% set selector_partial_telemetry = packet_selector_winner_entity_raw in invalid and packet_selector_winner_pool not in ['unknown', 'none', ''] %}

{# --- control + meta target surfaces --- #}
{% set helper_control_target = states('input_select.ma_active_target') %}
{% set component_active_target = states('sensor.component_active_target') %}
{% set runtime_control_target = states('sensor.ma_active_target') %}
{% set runtime_meta_target = states('sensor.ma_active_meta_entity') %}
{% set component_control_host = states('sensor.component_control_host') %}
{% set component_control_hosts = states('sensor.component_control_hosts') %}
{% set component_control_port = states('sensor.component_control_port') %}
{% set runtime_control_host = states('sensor.ma_control_host') %}
{% set runtime_control_hosts = states('sensor.ma_control_hosts') %}
{% set runtime_control_port = states('sensor.ma_control_port') %}
{% set route_control_host = route_trace.control_host if route_trace.control_host is defined else (route_trace.active_host if route_trace.active_host is defined else (route_trace.host if route_trace.host is defined else 'unknown')) %}
{% set route_control_port = route_trace.control_port if route_trace.control_port is defined else (route_trace.active_port if route_trace.active_port is defined else (route_trace.port if route_trace.port is defined else 'unknown')) %}

{% set effective_control_target = component_active_target if component_active_target not in invalid else (route_active_target if route_active_target not in invalid else (helper_control_target if helper_control_target not in invalid else runtime_control_target)) %}
{% set effective_meta_target = packet_meta_target if packet_meta_target not in invalid else (runtime_meta_target if runtime_meta_target not in invalid else effective_entity) %}
{% set effective_control_host = component_control_host if component_control_host not in invalid else (runtime_control_host if runtime_control_host not in invalid else route_control_host) %}
{% set effective_control_port = component_control_port if component_control_port not in invalid else (runtime_control_port if runtime_control_port not in invalid else route_control_port) %}

{# --- ESP/OLED telemetry --- #}
{% set esp_handoff = states('sensor.spectra_ls_system_esp_control_handoff_status') %}
{% set esp_target = states('sensor.spectra_ls_system_esp_control_target') %}
{% set esp_control_host_direct = states('sensor.spectra_ls_system_esp_control_host') %}
{% set esp_control_host_prefixed = states('sensor.living_room_spectra_ls_system_esp_control_host') %}
{% set esp_control_hosts_direct = states('sensor.spectra_ls_system_esp_control_hosts') %}
{% set esp_control_hosts_prefixed = states('sensor.living_room_spectra_ls_system_esp_control_hosts') %}
{% set esp_control_port_direct = states('sensor.spectra_ls_system_esp_control_port') %}
{% set esp_control_port_prefixed = states('sensor.living_room_spectra_ls_system_esp_control_port') %}
{% set esp_dynamic = namespace(host='', hosts='', port='') %}
{% for s in states.sensor %}
  {% set eid = s.entity_id if s.entity_id is defined else '' %}
  {% set st = s.state if s.state is defined else '' %}
  {% if esp_dynamic.host == '' and eid.endswith('_spectra_ls_system_esp_control_host') and st not in invalid %}
    {% set esp_dynamic.host = st %}
  {% endif %}
  {% if esp_dynamic.hosts == '' and eid.endswith('_spectra_ls_system_esp_control_hosts') and st not in invalid %}
    {% set esp_dynamic.hosts = st %}
  {% endif %}
  {% if esp_dynamic.port == '' and eid.endswith('_spectra_ls_system_esp_control_port') and st not in invalid %}
    {% set esp_dynamic.port = st %}
  {% endif %}
{% endfor %}
{% set esp_control_host = esp_control_host_direct if esp_control_host_direct not in invalid else (esp_control_host_prefixed if esp_control_host_prefixed not in invalid else (esp_dynamic.host if esp_dynamic.host not in invalid else (esp_control_hosts_direct if esp_control_hosts_direct not in invalid else (esp_control_hosts_prefixed if esp_control_hosts_prefixed not in invalid else esp_dynamic.hosts)))) %}
{% set esp_control_port = esp_control_port_direct if esp_control_port_direct not in invalid else (esp_control_port_prefixed if esp_control_port_prefixed not in invalid else esp_dynamic.port) %}
{% set esp_oled = states('sensor.spectra_ls_system_esp_oled_status') %}
{% set esp_mode = esp_oled.split('|', 1)[0] if esp_oled not in invalid and '|' in esp_oled else 'unknown' %}
{% set esp_oled_payload = esp_oled.split('oled:', 1)[1] if esp_oled not in invalid and 'oled:' in esp_oled else '' %}
{% set esp_oled_payload_trim = esp_oled_payload | trim %}

{# --- issue detection --- #}
{% set oled_src_fallback = false %}
{% if esp_oled not in invalid %}
  {% if esp_oled_payload_trim | upper == 'SRC' %}
    {% set oled_src_fallback = true %}
  {% elif '|SRC' in (esp_oled | upper) %}
    {% set oled_src_fallback = true %}
  {% endif %}
{% endif %}

{% set title_missing = effective_title in invalid %}
{% set source_missing = effective_source in invalid %}
{% set display_not_allowed = effective_display_allowed in ['off', 'false', '0'] %}
{% set stale_freshness = effective_freshness is not none and effective_freshness > 45 %}
{% set control_handoff_not_ready = esp_handoff in ['no_target', 'no_host', 'pending_refresh', 'unknown', 'unavailable', ''] %}
{% set not_audio_mode = esp_mode not in ['audio'] %}
{% set oled_blank_audio_payload = esp_mode == 'audio' and esp_oled_payload_trim in ['', '-'] %}

{# --- control-target normalization (entity_id vs friendly label) --- #}
{% set effective_control_friendly = state_attr(effective_control_target, 'friendly_name') if effective_control_target not in invalid else '' %}
{% set effective_control_name_norm = (effective_control_friendly | lower | replace('_', ' ') | trim) if effective_control_friendly not in invalid else '' %}
{% set effective_control_entity_norm = (effective_control_target | lower | replace('_', ' ') | replace('media_player.', '') | trim) if effective_control_target not in invalid else '' %}
{% set esp_target_norm = (esp_target | lower | replace('_', ' ') | trim) if esp_target not in invalid else '' %}

{# --- alignment checks --- #}
{% set control_target_route_mismatch = helper_control_target not in invalid and route_active_target not in invalid and helper_control_target != route_active_target %}
{% set packet_control_target_mismatch = metadata_values.control_target_vs_now_playing_mismatch if metadata_values.control_target_vs_now_playing_mismatch is defined else none %}
{% set packet_meta_target_mismatch = metadata_values.meta_target_vs_now_playing_mismatch if metadata_values.meta_target_vs_now_playing_mismatch is defined else none %}
{% set packet_intentional_divergence = metadata_values.intentional_control_metadata_divergence if metadata_values.intentional_control_metadata_divergence is defined else none %}
{% set control_target_now_playing_entity_mismatch = (packet_control_target_mismatch if packet_control_target_mismatch is not none else (effective_control_target not in invalid and effective_entity not in invalid and effective_control_target != effective_entity)) %}
{% set passthrough_split_brain_risk = false %}
{% set control_target_esp_mismatch = false %}
{% set control_host_esp_mismatch = false %}
{% if esp_target not in invalid and effective_control_target not in invalid %}
  {% if esp_target == effective_control_target %}
    {% set control_target_esp_mismatch = false %}
  {% elif esp_target_norm != '' and (esp_target_norm == effective_control_name_norm or esp_target_norm == effective_control_entity_norm) %}
    {% set control_target_esp_mismatch = false %}
  {% else %}
    {% set control_target_esp_mismatch = true %}
  {% endif %}
{% endif %}
{% if esp_control_host not in invalid and effective_control_host not in invalid and esp_control_host != effective_control_host %}
  {% set control_host_esp_mismatch = true %}
{% endif %}
{% set meta_target_entity_mismatch = (packet_meta_target_mismatch if packet_meta_target_mismatch is not none else (effective_meta_target not in invalid and effective_entity not in invalid and effective_meta_target != effective_entity)) %}
{% set metadata_owner_component = metadata_owner in ['component', 'component_primary', 'component_contract_surfaces'] %}
{% set metadata_owner_legacy = metadata_owner in ['legacy', 'legacy_contract_surfaces'] %}

{% set source_hint = (effective_source | lower) if effective_source not in invalid else '' %}
{% set app_hint = (effective_app | lower) if effective_app not in invalid else '' %}
{% set packet_app_hint = (packet_now_playing_app | lower) if packet_now_playing_app not in invalid else '' %}
{% set packet_source_hint = (packet_now_playing_source | lower) if packet_now_playing_source not in invalid else '' %}
{% set route_active_source_hint = (metadata_values.route_active_source | lower) if metadata_values.route_active_source is defined and metadata_values.route_active_source not in invalid else '' %}

{% set upstream = namespace(app='', app_id='', source='') %}
{% set context_entities = [packet_resolver_selected_meta_entity, effective_meta_target, runtime_meta_target, route_active_target, effective_control_target, effective_entity] %}
{% for entity_id in context_entities %}
  {% if entity_id not in invalid %}
    {% set attr_app = state_attr(entity_id, 'app_name') %}
    {% set attr_app_id = state_attr(entity_id, 'app_id') %}
    {% set attr_source = state_attr(entity_id, 'source') %}
    {% if upstream.app == '' and attr_app not in invalid %}
      {% set upstream.app = attr_app | string %}
    {% endif %}
    {% if upstream.app_id == '' and attr_app_id not in invalid %}
      {% set upstream.app_id = attr_app_id | string %}
    {% endif %}
    {% if upstream.source == '' and attr_source not in invalid %}
      {% set upstream.source = attr_source | string %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set upstream_app_hint = upstream.app | lower if upstream.app != '' else '' %}
{% set upstream_app_id_hint = upstream.app_id | lower if upstream.app_id != '' else '' %}
{% set upstream_source_hint = upstream.source | lower if upstream.source != '' else '' %}

{# Global upstream fallback scan: display policy may sanitize local app/source fields. #}
{% set upstream_global = namespace(found=false, entity='n/a', state='n/a', app='n/a', app_id='n/a', source='n/a', title='n/a') %}
{% for mp in states.media_player %}
  {% set mp_entity = mp.entity_id if mp.entity_id is defined else '' %}
  {% set mp_state = (mp.state | lower) if mp.state is defined else '' %}
  {% set mp_app = state_attr(mp_entity, 'app_name') %}
  {% set mp_app_id = state_attr(mp_entity, 'app_id') %}
  {% set mp_source = state_attr(mp_entity, 'source') %}
  {% set mp_title = state_attr(mp_entity, 'media_title') %}
  {% set mp_artist = state_attr(mp_entity, 'media_artist') %}
  {% set mp_blob = ((mp_app | string) ~ ' ' ~ (mp_app_id | string) ~ ' ' ~ (mp_source | string) ~ ' ' ~ (mp_title | string) ~ ' ' ~ (mp_artist | string)) | lower %}
  {% if not upstream_global.found and mp_state in ['playing', 'paused', 'buffering'] and ('apple' in mp_blob or 'youtube' in mp_blob) %}
    {% set upstream_global.found = true %}
    {% set upstream_global.entity = mp_entity if mp_entity not in invalid else 'n/a' %}
    {% set upstream_global.state = mp_state if mp_state not in invalid else 'n/a' %}
    {% set upstream_global.app = (mp_app | string) if mp_app not in invalid else 'n/a' %}
    {% set upstream_global.app_id = (mp_app_id | string) if mp_app_id not in invalid else 'n/a' %}
    {% set upstream_global.source = (mp_source | string) if mp_source not in invalid else 'n/a' %}
    {% set upstream_global.title = (mp_title | string) if mp_title not in invalid else 'n/a' %}
  {% endif %}
{% endfor %}

{% set appletv_youtube_context_contract = (
  ('apple' in source_hint) or ('youtube' in source_hint)
  or ('apple' in app_hint) or ('youtube' in app_hint)
  or ('apple' in packet_app_hint) or ('youtube' in packet_app_hint)
  or ('apple' in packet_source_hint) or ('youtube' in packet_source_hint)
  or ('apple' in route_active_source_hint) or ('youtube' in route_active_source_hint)
  or ('apple' in upstream_app_hint) or ('youtube' in upstream_app_hint)
  or ('apple' in upstream_source_hint) or ('youtube' in upstream_source_hint)
  or ('apple' in upstream_app_id_hint) or ('youtube' in upstream_app_id_hint)
) %}
{% set passthrough_source_tokens = ['optical', 'optical in', 'line in', 'line-in', 'aux', 'coax', 'hdmi', 'arc'] %}
{% set passthrough = namespace(detected=false) %}
{% for token in passthrough_source_tokens %}
  {% if token in source_hint %}
    {% set passthrough.detected = true %}
  {% endif %}
{% endfor %}
{% set passthrough_source_detected = passthrough.detected %}
{% set appletv_youtube_context = appletv_youtube_context_contract or (passthrough_source_detected and upstream_global.found) %}
{% set appletv_youtube_signal_source = 'none' %}
{% if appletv_youtube_context_contract %}
  {% set appletv_youtube_signal_source = 'direct_contract_or_packet_hint' %}
{% elif passthrough_source_detected and upstream_global.found %}
  {% set appletv_youtube_signal_source = 'passthrough_global_upstream_fallback' %}
{% endif %}
{% set passthrough_split_brain_risk = passthrough_source_detected and control_target_now_playing_entity_mismatch and effective_state in ['playing', 'paused'] %}
{% set selector_winner_is_effective_entity = packet_selector_winner_entity not in invalid and effective_entity not in invalid and packet_selector_winner_entity == effective_entity %}
{% set selector_low_confidence_pool = packet_selector_winner_pool in ['fallback_any', 'fallback_meta', 'unknown'] %}
{% set passthrough_meta_lock_intentional = (
  passthrough_source_detected
  and packet_selector_winner_pool == 'passthrough_meta_lock'
  and selector_winner_is_effective_entity
  and effective_state in ['playing', 'paused', 'buffering']
  and effective_display_allowed in ['on', 'true', '1']
) %}
{% set intentional_control_metadata_divergence = (packet_intentional_divergence if packet_intentional_divergence is not none else (control_target_now_playing_entity_mismatch
  and metadata_owner_component
  and (not meta_target_entity_mismatch or passthrough_meta_lock_intentional)
  and not control_target_route_mismatch
